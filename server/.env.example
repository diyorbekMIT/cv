MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/cv-website?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$... # bcrypt hash of your admin password
PORT=5000

# Set to "production" on Heroku — enables HTTPS redirect, secure cookies
# and serving the built React app from this same process.
NODE_ENV=development

# Public origin of the site. Used for CORS in local development.
CLIENT_URL=http://localhost:5173
